# 안내를 화면에 표시하는 함수
def show_guide(topic):
    guide = guides.get(topic)

    if guide is None:
        st.error("안내 자료를 찾을 수 없어요.")
        return

    st.markdown(f"### 🌼 {topic}")
    st.write("아래 순서대로 천천히 따라 해 보세요!")

    for i, step in enumerate(guide["steps"], start=1):
        st.markdown(f"**💗 {i}단계.** {step}")

    st.success("🌸 " + guide["example"])


# 🌈 상황별 버튼
st.divider()
st.header("🌼 1. 필요한 도움 선택하기")
st.write("원하는 항목을 눌러 보세요!")

topics = list(guides.keys())

for start in range(0, len(topics), 2):
    columns = st.columns(2)

    for offset, column in enumerate(columns):
        index = start + offset

        if index < len(topics):
            topic = topics[index]

            with column:
                if st.button(
                    topic,
                    key=f"button_{index}",
                    use_container_width=True
                ):
                    st.session_state["selected_topic"] = topic

if "selected_topic" in st.session_state:
    show_guide(st.session_state["selected_topic"])

# 💬 직접 질문하기
st.divider()
